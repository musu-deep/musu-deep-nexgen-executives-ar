{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "functions": {
    "api/v4.js": {
      "maxDuration": 60
    },
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "api/backend/**",
      "excludeFiles": "{src/**,public/**,node_modules/**,dist/**}"
    },
    "api/unified.py": {
      "maxDuration": 60,
      "includeFiles": "api/**"
    },
    "api/secure_unified.py": {
      "maxDuration": 60,
      "includeFiles": "api/**"
    },
    "api/secure_unified_v2.py": {
      "maxDuration": 60,
      "includeFiles": "api/**"
    },
    "api/executive_data.py": {
      "maxDuration": 60,
      "includeFiles": "api/**"
    },
    "api/group-accounts.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/executive-data", "destination": "/api/executive_data" },
    { "source": "/api/auth/group-accounts", "destination": "/api/group-accounts" },
    { "source": "/api/:path*", "destination": "/api/v4?route=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
