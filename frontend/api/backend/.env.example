# Core backend
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexgen_executives
JWT_SECRET=change-me-in-production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Operational provider: mongo | odoo | hybrid
# hybrid is recommended during rollout because it merges Odoo records with
# platform-native executive records.
OPERATIONAL_DATA_SOURCE=hybrid

# Odoo connection
ODOO_ENABLED=false
ODOO_URL=https://company.odoo.com
ODOO_DATABASE=database_name
ODOO_USERNAME=integration@company.com
ODOO_API_KEY=
ODOO_PROTOCOL=auto
ODOO_TIMEOUT=20
ODOO_READ_ONLY=true

# Mapping and filtering
ODOO_DEFAULT_SECTOR=corporate
ODOO_SECTOR_MAP_JSON={"investment":"investment","digital":"digital","academy":"academy","operations":"arak_development"}
ODOO_PROJECT_DOMAIN=[]
ODOO_TASK_DOMAIN=[]

# Optional custom fields used by your Odoo database
ODOO_PROJECT_BUDGET_FIELD=
ODOO_PROJECT_SECTOR_FIELD=
ODOO_PROJECT_PROGRESS_FIELD=progress
ODOO_TASK_SECTOR_FIELD=
ODOO_TASK_PROGRESS_FIELD=progress
